# Copia este archivo como ".env" y cambia TODOS los valores.
# El archivo ".env" NUNCA se sube a GitHub (esta en .gitignore).

# Clave para firmar los tokens JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria

# Base de datos de usuarios
USERS_DB_NAME=users
USERS_DB_USER=users_admin
USERS_DB_PASSWORD=cambia-esta-contrasena

# Base de datos AWaRe
AWARE_DB_NAME=aware
AWARE_DB_USER=aware_admin
AWARE_DB_PASSWORD=cambia-esta-otra-contrasena

# Modelo de IA (opcional; por defecto qwen2.5:3b). Mas ligero: qwen2.5:1.5b
# OLLAMA_MODEL=qwen2.5:3b

# Solo en el servidor publico (lo llena deploy/instalar.sh automaticamente)
# DOMAIN=129-80-1-2.sslip.io
